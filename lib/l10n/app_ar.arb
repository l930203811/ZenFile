  "changelog_v1132_fix_7": "Fixed residual blank icons on category page after deleting or moving files in non-media categories (Documents/Archives/Downloads/APKs).",
  "@changelog_v1132_fix_7": {
    "description": "v1.1.32 changelog: changelog_v1132_fix_7"
  },
