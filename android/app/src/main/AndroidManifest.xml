        <!-- 1×1 启动小组件：用导入的图片作为桌面图标。
             桌面主图标只能是编译期资源，小组件由启动器绘制、可承载运行时图片，
             是「用外部图片替换应用图标」在 Android 上唯一通用可行的方案。 -->
        <receiver
            android:name=".ZenFileIconWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/zenfile_icon_widget_info" />
        </receiver>

        <!-- ZenFileDocumentsProvider：**只**承担「用户选完文件后把路径转成 document URI
             回传给第三方 App」（grantUriPermissions 读写授权也靠它），
             **故意不声明 DOCUMENTS_PROVIDER 这个 intent-filter**。

             ⭐ 2026-10-04 装机定论（两张抽屉截图逐行对照得出）：
             - 系统选择器里**同一个包只会出现一条记录**：声明 DOCUMENTS_PROVIDER ⇒ 只显示
               「ZenFile Storage」根（点条目本体进 DocumentsUI 渲染的列表页，只有带 ↪ 的页面
               才能跳自家选择器），应用条目被这条根吃掉，且不再出现；
               不声明 ⇒ 才轮到「ZenFile」应用条目（点标题/图标都直接进 ZenFile 自家选择器）。
             - 用户优先级裁定（2026-10-04 15:0x）：**要应用条目** —— QQ/微信那类会列应用的抽屉里
               点一下直达自家文件浏览器。代价：WorkBuddy / Chrome 这类**只列 provider 根**的
               抽屉里 ZenFile 不再出现（官方文档亦称 DocumentsProvider 与 ACTION_GET_CONTENT
               应二选一，同时支持会让应用在选择器里出现两次、令用户困惑）。
             - ⚠️ 框架限制：provider 是后台 ContentProvider，无法跳转 Activity ⇒ 那种只列根的
               抽屉里「点条目本体直接进自家浏览器」**任何配置都做不到**。

             要恢复「ZenFile Storage」根：把下面的 provider 改回成对标签，并在其**内部**加
                 <intent-filter>
                     <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
                 </intent-filter>
             ⚠️ intent-filter 必须是 <provider> 的**子元素**：写在 provider 外面会挂到
             <application> 下，AAPT 直接报 "unexpected element <intent-filter> found in
             <manifest><application>" 构建失败（2026-10-04 踩过）。 -->
        <provider
            android:name=".ZenFileDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />

